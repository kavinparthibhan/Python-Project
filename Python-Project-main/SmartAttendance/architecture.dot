  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.8"];
  node [shape=box, style="rounded,filled", fillcolor="#E8F1FC", color="#4576A8", fontname="Helvetica", fontsize=13, margin="0.20,0.14"];
